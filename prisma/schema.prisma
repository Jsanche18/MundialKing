datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  members      GroupMember[]
  predictions  Prediction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Group {
  id           String        @id @default(uuid())
  name         String
  inviteCode   String        @unique
  maxMembers   Int           @default(10)
  passwordHash String?       // Optional password to join
  members      GroupMember[]
  predictions  Prediction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GroupMember {
  id                   String   @id @default(uuid())
  userId               String
  groupId              String
  totalPoints          Int      @default(0)
  exactScores          Int      @default(0)
  tendencies           Int      @default(0)
  draftGoalsPoints     Int      @default(0)
  selectedTeamId       Int?
  selectedPlayerId     Int?
  predictedTopScorerId Int?

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group              Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  selectedTeam       Team?   @relation(fields: [selectedTeamId], references: [apiId], onDelete: SetNull)
  selectedPlayer     Player? @relation(fields: [selectedPlayerId], references: [apiId], onDelete: SetNull)
  predictedTopScorer Player? @relation(name: "TopScorerPrediction", fields: [predictedTopScorerId], references: [apiId], onDelete: SetNull)

  // Enforce unique draft picks per group
  @@unique([groupId, selectedTeamId])
  @@unique([groupId, selectedPlayerId])
  // Allow only one membership entry per user in a group
  @@unique([userId, groupId])
}

model Team {
  apiId        Int           @id // The ID from API-Football
  name         String
  flagUrl      String
  currentStage String        @default("Fase de Grupos")
  
  groupMembers GroupMember[]
  homeMatches  Match[]       @relation("HomeMatches")
  awayMatches  Match[]       @relation("AwayMatches")
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Player {
  apiId        Int           @id // The ID from API-Football
  name         String
  teamId       Int?
  position     String        // e.g., Delantero, Centrocampista
  photoUrl     String

  groupMembers   GroupMember[]
  predictedTopScorers GroupMember[] @relation("TopScorerPrediction")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Match {
  apiId            Int          @id // The ID from API-Football
  homeTeamId       Int
  awayTeamId       Int
  kickoffTimestamp DateTime     // UTC
  status           String       // NS, LIVE, FT, etc.
  homeGoals        Int?
  awayGoals        Int?
  
  homeTeam         Team         @relation("HomeMatches", fields: [homeTeamId], references: [apiId], onDelete: Cascade)
  awayTeam         Team         @relation("AwayMatches", fields: [awayTeamId], references: [apiId], onDelete: Cascade)
  predictions      Prediction[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Prediction {
  id         String   @id @default(uuid())
  userId     String
  groupId    String
  matchId    Int
  homeGoals  Int
  awayGoals  Int
  locked     Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [apiId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Enforce only one prediction per user/group/match
  @@unique([userId, groupId, matchId])
}
